{
  "manifest_version": 3,
  "name": "PERSONAL_CHAT_AI",
  "version": "1.3.0",
  "version_name": "1.3.0",
  "description": "Borradores privados de respuesta con IA local.",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "clipboardWrite", "offscreen"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "PERSONAL_CHAT_AI", "default_popup": "connection.html" },
  "options_page": "connection.html",
  "content_scripts": [{
    "matches": ["https://stripchat.com/*", "https://*.stripchat.com/*"],
    "js": ["backend-config.js", "account-detector.js", "account-setup.js", "conversation-detector.js", "suggestion-flow.js", "content.js"],
    "css": ["panel.css"],
    "run_at": "document_idle"
  }]
}
